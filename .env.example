APP_ENV=development
APP_NAME=HAPPY Management Platform
HAPPY_RELEASE_VERSION=1.0.0-rc.1
LOG_LEVEL=INFO
API_CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://happy:happy_dev_password@localhost:5432/happy
POSTGRES_DB=happy
POSTGRES_USER=happy
POSTGRES_PASSWORD=happy_dev_password
POSTGRES_PORT=5432
DOCKER_POSTGRES_ADMIN_PASSWORD=happy_local_admin_password
# Installed PostgreSQL only: used by pnpm db:setup, not by the API.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=happy-local-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=happy_local
S3_SECRET_ACCESS_KEY=happy_local_storage_password
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=database/
BACKUP_RETENTION_DAYS=35
RESTORE_ADMIN_URL=
ALERT_WEBHOOK_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS={}
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_RELEASE_VERSION=1.0.0-rc.1
API_INTERNAL_URL=http://127.0.0.1:8000
AUTH_SESSION_HOURS=8
AUTH_IDLE_MINUTES=30
AUTH_LOGIN_LIMIT=5
AUTH_IP_LIMIT=30
AUTH_WINDOW_MINUTES=15
# Optional OpenID Connect provider. Configure all values together.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGIN_URI=
OIDC_PROVIDER_NAME=Organizational SSO
OIDC_ALLOWED_EMAIL_DOMAINS=[]
DEMAND_VACANCY_CONFIRMATION_REQUIRED=true
# Configure only after programme owners approve the privacy notice and checklist.
SUPPLY_PRIVACY_NOTICE_VERSION=
SUPPLY_ONBOARDING_POLICY_APPROVED=false
SUPPLY_REQUIRED_FIELDS=[]
SUPPLY_REQUIRED_SECTIONS=["basic","contact","consent"]
FILE_MAX_BYTES=10485760
# clamd must be on a trusted private network; missing scanner blocks downloads.
FILE_SCAN_HOST=
FILE_SCAN_PORT=3310
# Labels reserved for the approved CV parser adapter. These do not activate a transport.
CV_PARSER_PROVIDER=
CV_PARSER_MODEL=
CV_PARSER_URL=
CV_PARSER_TOKEN=
CV_PARSER_TIMEOUT_SECONDS=60
CV_PARSER_MAX_ATTEMPTS=5
# Server-to-server bearer token stored in Google Apps Script properties, never in the PWA.
HAMIS_INTEGRATION_TOKEN=
EMPLOYER_PORTAL_INTEGRATION_TOKEN=
# Fernet key and independent random lookup secret (at least 32 characters).
IDENTITY_ENCRYPTION_KEY=
IDENTITY_LOOKUP_KEY=
