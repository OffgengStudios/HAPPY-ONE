# Copy to a private file outside version control or provision in the secret manager.
# Blank inputs deliberately fail release:preflight. Use approved production values.
APP_ENV=production
DATABASE_URL=
API_CORS_ORIGINS=[]
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Generate a URL-safe base64 Fernet key from 32 random bytes using cryptography.
# Preserve this key and the independent lookup key in the approved secret manager.
IDENTITY_ENCRYPTION_KEY=
IDENTITY_LOOKUP_KEY=
SUPPLY_PRIVACY_NOTICE_TEXT=
SUPPLY_PRIVACY_NOTICE_VERSION=
EMPLOYER_INTAKE_NOTICE_TEXT=
SUPPLY_ONBOARDING_POLICY_APPROVED=false
SUPPLY_REQUIRED_FIELDS=[]
SUPPLY_REQUIRED_SECTIONS=["basic","contact","consent"]
FILE_SCAN_HOST=
FILE_SCAN_PORT=3310
CV_PARSER_HOSTPORT=
CV_PARSER_TOKEN=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=database/
BACKUP_RETENTION_DAYS=
ALERT_WEBHOOK_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS={}
# Set RESTORE_ADMIN_URL only on the restore job, targeting an isolated maintenance
# server/database. Optional OIDC settings are listed in the existing .env.example.
