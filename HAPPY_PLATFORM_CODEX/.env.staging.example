APP_ENV=staging
APP_NAME=HAPPY Management Platform
LOG_LEVEL=INFO
API_CORS_ORIGINS=["https://happy-staging.example.org"]
DATABASE_URL=postgresql+psycopg://happy_staging:REPLACE_WITH_STAGING_DB_PASSWORD@postgres:5432/happy_staging
POSTGRES_DB=happy_staging
POSTGRES_USER=happy_staging
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD
DOCKER_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_SEPARATE_ADMIN_PASSWORD
S3_ENDPOINT_URL=http://object-storage:9000
S3_REGION=us-east-1
S3_BUCKET=happy-staging-private
S3_ACCESS_KEY_ID=REPLACE_WITH_STAGING_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_SECRET
NEXT_PUBLIC_API_BASE_URL=https://happy-api-staging.example.org/api/v1
NEXT_PUBLIC_APP_ENV=staging
API_INTERNAL_URL=http://api:8000
AUTH_SESSION_HOURS=8
AUTH_IDLE_MINUTES=30
AUTH_LOGIN_LIMIT=5
AUTH_IP_LIMIT=30
AUTH_WINDOW_MINUTES=15
# Legacy adapters only. Public intake frontends never receive these credentials.
HAMIS_INTEGRATION_TOKEN=
EMPLOYER_PORTAL_INTEGRATION_TOKEN=
# Programme-approved text and requirements must be configured before intake opens.
SUPPLY_PRIVACY_NOTICE_VERSION=
SUPPLY_PRIVACY_NOTICE_TEXT=
EMPLOYER_INTAKE_NOTICE_TEXT=
SUPPLY_ONBOARDING_POLICY_APPROVED=false
SUPPLY_REQUIRED_FIELDS=[]
SUPPLY_REQUIRED_SECTIONS=["basic","contact","consent","review"]
PUBLIC_INTAKE_LIMIT=20
CV_PARSER_HOSTPORT=
CV_PARSER_TOKEN=
FILE_SCAN_HOST=
FILE_SCAN_PORT=3310
IDENTITY_ENCRYPTION_KEY=
IDENTITY_LOOKUP_KEY=
